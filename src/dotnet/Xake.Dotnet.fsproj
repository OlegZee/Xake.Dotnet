<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Xake.Dotnet</AssemblyName>

    <!-- The one package of this repository: Xake.Dotnet.dll and, added by IncludeHermeticOutput
         below, Xake.Hermetic.Dotnet.dll, at one version. The engine is the published `Xake`
         package (XakeVersion, a range: its floor is the version this repository builds against,
         moved by `build.fsc.fsx bump-base`; -p:XakeVersion=... overrides it, CI's xake-latest). -->
    <PackageId>Xake.Dotnet</PackageId>
    <XakeVersion Condition="'$(XakeVersion)' == ''">[4.0.0, 5.0)</XakeVersion>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeHermeticOutput</TargetsForTfmSpecificBuildOutput>
    <OutputType>Library</OutputType>
    <!-- The SDK would otherwise reference its own FSharp.Core, see the pin below. -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TargetFrameworks>net462;netstandard2.0</TargetFrameworks>
    <Copyright>(c) OlegZee 2014-2026</Copyright>
    <Authors>OlegZee</Authors>

    <Description>Xake build tool: the .NET tasks (csc, fsc, msbuild, resgen, project descriptions) and reproducible builds (lock files, restore, SBOM, verification, packing, signing)</Description>
    <PackageProjectUrl>https://github.com/OlegZee/Xake.Dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/OlegZee/Xake.Dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>fsharp;build;make;buildtool;csc;fsc;dotnet;reproducible;lockfile;sbom</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/OlegZee/Xake.Dotnet/blob/master/docs/release-notes.md</PackageReleaseNotes>
  </PropertyGroup>

  <!-- nuget.org renders these; they are packed, not referenced by path, so the files have to
       be listed explicitly. -->
  <ItemGroup>
    <None Include="..\..\Icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Tool.fs" />
    <Compile Include="Hash.fs" />
    <Compile Include="DotNetFwk.fs" />
    <Compile Include="HermeticMode.fs" />
    <Compile Include="ResourceFileset.fs" />
    <!-- Resx has no dependency on Fsproj/DotnetTasks; it is compiled here (ahead of
         DotnetTasks.fs) because DotnetTasks.fs's Impl.compileResx calls into it on
         netstandard2.0. -->
    <Compile Include="ResxFormat.fs" />
    <Compile Include="Resx.fs" />

    <Compile Include="DotnetTasks.fs" />
    <Compile Include="CscArgs.fs" />
    <Compile Include="FscArgs.fs" />
    <Compile Include="CompilerRunner.fs" />
    <!-- The project description (xake.project.json) as data, and what a description adds to a
         composed compilation (csc/fsc { project "path" }); ahead of Csc.fs and Fsc.fs, whose
         ofSettings apply it. Lock-free: no restore, no msbuild. -->
    <Compile Include="Json.fs" />
    <Compile Include="Description.fs" />
    <Compile Include="ProjectPlan.fs" />
    <!-- The resolved compilations (`Csc`, `Fsc`), their settings and runners; then the csc {}
         and fsc {} builders over them. The lock, restore, SBOM, verification, packing and signing live in
         an assembly of their own (Xake.Hermetic.Dotnet, src/hermetic), which references this project,
         never the other way round; it ships in this project's package. -->
    <Compile Include="Csc.fs" />
    <Compile Include="Fsc.fs" />
    <!-- A satellite assembly's compile from the main assembly (its metadata) and resource sets:
         the core of satellite {} and of the hermetic Locks.satellite. -->
    <Compile Include="Satellite.fs" />
    <!-- satellite {}: the core above over a template and resource sets, no lock -->
    <Compile Include="Dotnet.satellite.fs" />
    <Compile Include="Dotnet.csc.fs" />
    <Compile Include="Dotnet.fsc.fs" />
    <Compile Include="Dotnet.resgen.fs" />
    <Compile Include="Dotnet.Msbuild.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Xake" Version="$(XakeVersion)" />
    <!-- A satellite's template read from its metadata, the same on every OS (Satellite.fs); part of
         .NET's shared framework, so the version is the lowest one a script runs on (.NET 8). -->
    <PackageReference Include="System.Reflection.Metadata" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>dotnet.tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Xake.Hermetic.Dotnet.dll and .xml next to Xake.Dotnet.dll in lib/{tfm}. src/hermetic
       references this project, so it cannot be a project reference here (a cycle): it is built
       by an explicit MSBuild call (same configuration, framework and version) when the package
       is assembled. -->
  <Target Name="IncludeHermeticOutput">
    <MSBuild Projects="..\hermetic\Xake.Hermetic.Dotnet.fsproj" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)" />
    <ItemGroup>
      <BuildOutputInPackage Include="..\hermetic\bin\$(Configuration)\$(TargetFramework)\Xake.Hermetic.Dotnet.dll" />
      <BuildOutputInPackage Include="..\hermetic\bin\$(Configuration)\$(TargetFramework)\Xake.Hermetic.Dotnet.xml" />
    </ItemGroup>
  </Target>

  <!-- ResXResourceReader, needed to compile .resx, lives in System.Windows.Forms and is not
       one of the SDK's implicit references for net462. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

  <!-- PreserializedResourceWriter: .resx compiled as the .NET SDK's GenerateResource does (ResxFormat.fs) -->
  <ItemGroup>
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
  </ItemGroup>

  <!-- Kept in step with the `Xake` package: this is the FSharp.Core floor the package imposes
       on its consumers. -->
  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="8.0.100" />
  </ItemGroup>
</Project>
